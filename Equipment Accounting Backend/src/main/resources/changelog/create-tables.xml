<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-tables" author="Muhammed">
        <createTable tableName="driver">
            <column name="id" type="int4">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="varchar(50)"/>
            <column name="login" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="varchar(30)"/>
        </createTable>

        <createTable tableName="spaceship_manufacturer">
            <column name="id" type="int4">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(50)"/>
            <column name="nasdaq_code" type="varchar(50)"/>
        </createTable>

        <createTable tableName="spaceship_model">
            <column name="id" type="int4">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="manufacturer_id" type="int4">
                <constraints foreignKeyName="fk_model_manufacturer" references="spaceship_manufacturer(id)" nullable="false"/>
            </column>
            <column name="model_name" type="varchar(50)"/>
            <column name="horsepower" type="float8">
                <constraints nullable="false"/>

            </column>
        </createTable>
        <sql>
            ALTER TABLE spaceship_model
            ADD CONSTRAINT chk_horsepower_range
            CHECK (horsepower BETWEEN 170000000 AND 240000000)
        </sql>

        <createTable tableName="spaceship">
            <column name="id" type="int4">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ship_number" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="model_id" type="int4">
                <constraints nullable="false" foreignKeyName="fk_spaceship_model" references="spaceship_model(id)"/>
            </column>
        </createTable>

        <createTable tableName="spaceship_rent">
            <column name="driver_id" type="int4">
                <constraints nullable="false" foreignKeyName="fk_driver" references="driver(id)"/>
            </column>
            <column name="spaceship_id" type="int4">
                <constraints nullable="false" foreignKeyName="fk_spaceship" references="spaceship(id)"/>
            </column>
            <column name="rent_start" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="rent_end" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <sql>
                ALTER TABLE spaceship_model
                DROP CONSTRAINT chk_horsepower_range
            </sql>
            <dropTable tableName="spaceship_rent"/>
            <dropTable tableName="spaceship"/>
            <dropTable tableName="spaceship_model"/>
            <dropTable tableName="spaceship_manufacturer"/>
            <dropTable tableName="driver"/>
        </rollback>



    </changeSet>
</databaseChangeLog>